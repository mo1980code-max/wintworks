# WintWorks legacy spam removal (Apache / LiteSpeed)
# Return an explicit 410 Gone for inherited casino/spam URLs.
<IfModule mod_alias.c>
  RedirectMatch 410 "(?i)^/(?:tai-app-sunwin|sunwin[^/]*|tai-[^/]*|page9\.html)(?:/.*)?$"
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Security and content-type basics.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
